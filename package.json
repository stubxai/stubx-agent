{
  "name": "@stubx/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Public skeleton of the STUBX agent. No wallet, no signing, no custody, no network writes.",
  "license": "MIT",
  "author": "STUBX <stubxai.hq@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stubxai/stubx-agent.git"
  },
  "bugs": {
    "email": "stubxai.hq@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-reporter=spec --test-reporter=./scripts/test-report.js --test-reporter-destination=stdout --test-reporter-destination=test-reporter-out.txt \"dist/test/**/*.test.js\"",
    "ppm:print": "tsc && node dist/src/cli.js ppm:print",
    "scan:forbidden": "tsc && node dist/src/cli.js scan:forbidden"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
